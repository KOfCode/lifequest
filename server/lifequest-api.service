[Unit]
Description=LifeQuest sync API
After=network.target
[Service]
User=lifequest
Group=lifequest
ExecStart=/usr/bin/python3 /opt/lifequest/lifequest_api.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lifequest
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
